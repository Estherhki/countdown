<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Countdown</title>
  <style>
    :root {
      --bg: #0b0f14;
      --card: rgba(255,255,255,0.08);
      --text: #ffffff;
      --muted: rgba(255,255,255,0.75);
      --accent: #ffb020;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      background: radial-gradient(1200px 800px at 20% 10%, #1b2a4a 0%, transparent 60%),
                  radial-gradient(1000px 700px at 90% 90%, #3b1b3f 0%, transparent 55%),
                  var(--bg);
      color: var(--text);
      padding: 20px;
    }
    .card {
      width: min(520px, 100%);
      background: var(--card);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 18px;
      padding: 20px 18px;
      backdrop-filter: blur(10px);
    }
    .title {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }
    .title h1 {
      font-size: 16px;
      margin: 0;
      letter-spacing: 0.2px;
    }
    .title .date {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }
    .box {
      border-radius: 14px;
      padding: 14px 10px;
      background: rgba(0,0,0,0.18);
      border: 1px solid rgba(255,255,255,0.10);
      text-align: center;
    }
    .num {
      font-size: 28px;
      font-weight: 750;
      line-height: 1;
      letter-spacing: 0.5px;
    }
    .label {
      margin-top: 8px;
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 0.6px;
      text-transform: uppercase;
    }
    .bar {
      margin-top: 14px;
      height: 8px;
      background: rgba(255,255,255,0.10);
      border-radius: 999px;
      overflow: hidden;
    }
    .bar > div {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--accent), #ff4d6d);
      border-radius: 999px;
      transition: width 0.3s ease;
    }
    .foot {
      margin-top: 12px;
      font-size: 12px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }
    .done {
      display: none;
      margin-top: 12px;
      padding: 10px 12px;
      border-radius: 12px;
      background: rgba(16, 185, 129, 0.18);
      border: 1px solid rgba(16, 185, 129, 0.35);
      color: rgba(209, 250, 229, 0.95);
      font-size: 13px;
    }
    @media (max-width: 420px) {
      .grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="title">
      <h1 id="heading">Countdown</h1>
      <div class="date" id="targetLabel"></div>
    </div>

    <div class="grid">
      <div class="box"><div class="num" id="days">—</div><div class="label">Days</div></div>
      <div class="box"><div class="num" id="hours">—</div><div class="label">Hours</div></div>
      <div class="box"><div class="num" id="mins">—</div><div class="label">Minutes</div></div>
      <div class="box"><div class="num" id="secs">—</div><div class="label">Seconds</div></div>
    </div>

    <div class="bar" aria-hidden="true"><div id="progress"></div></div>

    <div class="done" id="doneMsg">It’s July 1, 2026.</div>

    <div class="foot">
      <div id="statusText">Loading…</div>
      <div id="tzText"></div>
    </div>
  </div>

  <script>
    /**
     * Customize:
     * - titleText: shown at top
     * - targetISO: target datetime in ISO format
     *   If you want “midnight local time”, keep it at 00:00:00 and use your timeZone in formatting only.
     */
    const titleText = "Countdown to July 1";
    const targetISO = "2026-07-01T00:00:00"; // local midnight on the viewer's device

    const heading = document.getElementById("heading");
    const targetLabel = document.getElementById("targetLabel");
    const tzText = document.getElementById("tzText");
    const statusText = document.getElementById("statusText");
    const doneMsg = document.getElementById("doneMsg");

    const elDays = document.getElementById("days");
    const elHours = document.getElementById("hours");
    const elMins = document.getElementById("mins");
    const elSecs = document.getElementById("secs");
    const progress = document.getElementById("progress");

    heading.textContent = titleText;

    const target = new Date(targetISO);
    const start = new Date(); // used for a simple progress estimate (from now until target)

    function pad(n) { return String(n).padStart(2, "0"); }

    function fmtTarget(d) {
      return d.toLocaleString(undefined, {
        year: "numeric", month: "short", day: "2-digit",
        hour: "2-digit", minute: "2-digit"
      });
    }

    targetLabel.textContent = fmtTarget(target);
    tzText.textContent = Intl.DateTimeFormat().resolvedOptions().timeZone || "";

    function tick() {
      const now = new Date();
      const diffMs = target - now;

      if (diffMs <= 0) {
        elDays.textContent = "0";
        elHours.textContent = "00";
        elMins.textContent = "00";
        elSecs.textContent = "00";
        progress.style.width = "100%";
        statusText.textContent = "Done";
        doneMsg.style.display = "block";
        return;
      }

      doneMsg.style.display = "none";

      const totalSeconds = Math.floor(diffMs / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const mins = Math.floor((totalSeconds % 3600) / 60);
      const secs = totalSeconds % 60;

      elDays.textContent = String(days);
      elHours.textContent = pad(hours);
      elMins.textContent = pad(mins);
      elSecs.textContent = pad(secs);

      // progress bar: from "start time" to target (simple, based on when you opened it)
      const totalWindow = target - start;
      const elapsed = now - start;
      const pct = Math.max(0, Math.min(100, (elapsed / totalWindow) * 100));
      progress.style.width = pct.toFixed(2) + "%";

      statusText.textContent = `T-minus ${days}d ${pad(hours)}h ${pad(mins)}m`;
    }

    tick();
    setInterval(tick, 1000);
  </script>
</body>
</html>
